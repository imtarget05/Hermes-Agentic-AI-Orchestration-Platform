LLM_PROVIDER=cloudflare
LLM_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# ---- Telegram 1:1 chat (local-first webhook + tunnel) ----
# polling fallback: make approval-bot ; webhook prod/local: POST /telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_SESSION_DB=./telegram_sessions.db
TELEGRAM_MODE=webhook          # webhook | polling
TELEGRAM_MAX_HISTORY=20
HERMES_DB_PATH=./hermes_tasks.db
HERMES_ROUTING_PATH=./routing.json
HERMES_SANDBOX_DIR=./sandbox
# Deployment (Render web service): token protecting POST /run (leave empty to disable auth)
HERMES_API_TOKEN=
# Comma-separated origins allowed to call the API from a browser (Cloudflare Pages domain)
HERMES_CORS_ORIGINS=*

# ---- Hermes Procurement Case Agent (Multi-Agent RAG) ----
# Override path of the async procurement store (default: <HERMES_DB_PATH minus .db>_procurement.db)
HERMES_PROCUREMENT_DB=
# Path of the RAG case index JSON (default: set per-case by the runner)
HERMES_RAG_INDEX=
# Auto-approve purchase recommendations without a human (tests/CI/demo)
HERMES_HITL_AUTO_APPROVE=

# ---- Hermes Project 1 — async task queue engine ----
# Infra wiring (docker compose): memory mode runs with zero extra services.
HERMES_ASYNC_MODE=memory          # memory | rabbitmq
HERMES_RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
HERMES_ASYNC_DB_PATH=./async_tasks.db

# ---- HERMES-01/09: hard budgets (spawn limits + cost control) ----
# max tasks a single workflow/plan may create
HERMES_MAX_TASKS_PER_WORKFLOW=50
# max distinct agent types per workflow
HERMES_MAX_AGENTS=8
# max attempts cap per task
HERMES_MAX_ITERATIONS=5
# workflow token budget (STOP when hit)
HERMES_MAX_TOKEN_BUDGET=200000
# workflow wall-clock budget
HERMES_MAX_TIME_BUDGET_SECONDS=300
# workflow cost budget (STOP when hit)
HERMES_MAX_COST_USD=10.0

# ---- HERMES-04: RabbitMQ consumer prefetch (fair dispatch; 0 disables) ----
HERMES_PREFETCH_COUNT=10

# ---- HERMES-11: external memory trust boundary (only if a memory/skill
# store is integrated, e.g. TencentDB Agent Memory). Fail-closed: leave unset
# unless an operator review gate explicitly permits promotion. ----
HERMES_MEMORY_TRUST_REVIEWED_ONLY=0
