{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "Hermes — Async Task Queue",
  "uid": "hermes-async",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Throughput (tasks/sec)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(hermes_tasks_completed_total[1m]))", "refId": "A" }
      ]
    },
    {
      "id": 2, "type": "stat", "title": "Queue depth",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "sum(hermes_task_queue_depth)", "refId": "A" }
      ]
    },
    {
      "id": 3, "type": "stat", "title": "Active workers",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(hermes_worker_active)", "refId": "A" }
      ]
    },
    {
      "id": 4, "type": "stat", "title": "Retry rate",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "sum(rate(hermes_tasks_retried_total[1m])) / sum(rate(hermes_tasks_total[1m]))", "refId": "A" }
      ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Task latency (p95, seconds)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(hermes_task_duration_seconds_bucket[1m])) by (le))", "refId": "A" },
        { "expr": "histogram_quantile(0.50, sum(rate(hermes_task_duration_seconds_bucket[1m])) by (le))", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Completed vs failed vs retried",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "sum(rate(hermes_tasks_completed_total[1m]))", "refId": "A" },
        { "expr": "sum(rate(hermes_tasks_failed_total[1m]))", "refId": "B" },
        { "expr": "sum(rate(hermes_tasks_retried_total[1m]))", "refId": "C" }
      ]
    },
    {
      "id": 7, "type": "gauge", "title": "Worker utilization",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "targets": [
        { "expr": "avg(hermes_worker_utilization)", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 } }
    }
  ]
}